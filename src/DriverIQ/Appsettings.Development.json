{
	"Environment": "Development",
	"Logging": {
		"Usings": [ "Serilog.Sinks.Async", "Serilog.Sinks.Console" ],
		"MinimumLevel": {
            "Default": "Verbose",
            "Override": {
                "Microsoft": "Information",
                "System": "Warning"
            }
        },
        "Writeto": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "Console",
                            "Args": {
                                "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
                                "RestrictedToMinimumLevel": "Verbose"
                            }
                        }
                    ]
                }
            }
        ],
	}
}