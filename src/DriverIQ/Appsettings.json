{
	"Environment": "Production",
	"Logging": {
		"Usings": [ "Serilog.Sinks.Async", "Serilog.Sinks.EventLog" ],
		"MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information",
                "System": "Warning"
            }
        },
        "Writeto": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "EventLog",
                            "Args": {
                                "Source": "DriverIQ",
                                "ManageEventSource": true,
                                "RestrictedToMinimumLevel": "Verbose"
                            }
                        }
                    ]
                }
            }
        ],
	}
}